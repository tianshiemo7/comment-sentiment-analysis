# 复制为 .env 后按需修改（.env 已被 .gitignore 忽略）

# ---------- 推理服务 ----------
API_HOST=0.0.0.0
API_PORT=8000
# 当前生效的模型：cnn | bilstm_attention | bert
ACTIVE_MODEL=bilstm_attention

# ---------- 路径配置 ----------
DATA_DIR=data
MODEL_DIR=models
OUTPUT_DIR=outputs

# ---------- 爬虫（遵守 robots 协议，控制请求频率） ----------
# 通用 HTML 爬虫默认间隔；B 站接口爬虫默认 2.5 秒且 CLI 强制 --delay >= 2
CRAWL_DELAY_SECONDS=1.5
CRAWL_TIMEOUT=15
CRAWL_USER_AGENT=comment-sentiment-analysis-course/0.1 (+https://github.com/tianshiemo7/comment-sentiment-analysis)

# API 主机（api.bilibili.com）robots.txt 当前为 Disallow: / 时的处理策略：
#   warn（默认）= 告警 + 如实记录后继续；enforce = 直接拒绝；ignore = 不检查
BILI_API_ROBOTS_POLICY=warn
# 是否自动初始化 buvid3/buvid4。实测携带 buvid3 会把匿名可见评论限制为 3 条，默认关闭。
BILI_INIT_BUVID=0

# 可选：登录态（仅由使用者自行提供，源码不含任何凭据）
# BILI_SESSDATA=
# BILI_BILI_JCT=
# BILI_DEDEUSERID=

# ---------- 公开数据集 / 标注（scripts/get_data.sh） ----------
# 数据集下载目录；来源会自动登记到 data/raw/来源说明.md
DATASET_DIR=data/raw/datasets
# 标注候选与合并后的标注文件目录
LABELING_DIR=data/labeling

# ---------- /api/videos 真实爬取（opt-in，默认关闭） ----------
# 置 1 时「采集评论」阶段调用真实爬虫；默认 0 走占位数据，测试/演示无需联网
VIDEO_REAL_CRAWL=0
VIDEO_CRAWL_MAX_PAGES=1
VIDEO_CRAWL_MAX_ITEMS=200
VIDEO_CRAWL_DELAY=2.5
VIDEO_CRAWL_INCLUDE_REPLIES=0
VIDEO_CRAWL_TIMEOUT=15

# ---------- 训练超参数（默认值，可在命令行覆盖） ----------
MAX_LEN=200
MIN_FREQ=3
BATCH_SIZE=64
EPOCHS=20
LEARNING_RATE=0.001
SEED=42
