# 复制为 .env 后按需修改（.env 已被 .gitignore 忽略）

# ---------- 推理服务 ----------
API_HOST=0.0.0.0
API_PORT=8000
# 当前生效的模型：cnn | bilstm_attention | bert
ACTIVE_MODEL=bilstm_attention

# ---------- 路径配置 ----------
DATA_DIR=data
MODEL_DIR=models
OUTPUT_DIR=outputs

# ---------- 系统设置 / 账号（Web 界面「设置」弹窗） ----------
# 设置文件落盘路径（默认 outputs/settings.json）。
# 内含 B 站 Cookie 明文：已被 .gitignore 忽略，切勿提交或分享；接口只回 masked_cookie。
# 文件不存在或损坏时按内置默认值返回（匿名 / 真实采集 / 关闭自动连续）。
CSA_SETTINGS_PATH=outputs/settings.json
# 可选依赖 Playwright（仅「登录 B 站账号（弹出登录窗口）」需要；未安装不影响其它功能，
# 手动粘贴 Cookie 仍可用）：pip install playwright && python -m playwright install chromium
# Windows 已安装 Edge 时可直接用系统 Edge（channel=msedge），无需另装 Chromium。

# ---------- 爬虫（遵守 robots 协议，控制请求频率） ----------
# 通用 HTML 爬虫默认间隔；B 站接口爬虫默认 2.5 秒且 CLI 强制 --delay >= 2
CRAWL_DELAY_SECONDS=1.5
CRAWL_TIMEOUT=15
CRAWL_USER_AGENT=comment-sentiment-analysis-course/0.1 (+https://github.com/tianshiemo7/comment-sentiment-analysis)

# API 主机（api.bilibili.com）robots.txt 当前为 Disallow: / 时的处理策略：
#   warn（默认）= 告警 + 如实记录后继续；enforce = 直接拒绝；ignore = 不检查
BILI_API_ROBOTS_POLICY=warn
# 是否自动初始化 buvid3/buvid4。实测携带 buvid3 会把匿名可见评论限制为 3 条，默认关闭。
BILI_INIT_BUVID=0

# 可选：登录态（仅由使用者自行提供，源码不含任何凭据）
# 大规模采集建议配置登录态；匿名可见量随接口策略波动（实测单视频 3~200+ 条，未必全量）。
# Web 界面推荐用「设置 → 登录 B 站账号（弹出登录窗口）」由人完成登录，Cookie 自动存
#   outputs/settings.json；也可在设置页「高级：手动粘贴 Cookie」。
# 下面这些环境变量供 CLI 与不带 settings 的旧请求使用（Web 任务级 settings 优先）。
# 方式一：完整 Cookie 串（从浏览器开发者工具复制，勿提交到仓库）
# BILI_COOKIE=SESSDATA=...; bili_jct=...; DedeUserID=...
# 方式二：单个变量
# BILI_SESSDATA=
# BILI_BILI_JCT=
# BILI_DEDEUSERID=

# 大规模采集：BV 清单文件（一行一个；也可在命令行 --bvid-file 指定）
# BV_LIST_FILE=data/raw/bvids.txt
# 单个视频是否跳过已完成断点（默认 1；0=强制重扫）
BILI_SKIP_FINISHED=1
# 未登录时是否直接失败（大规模采集建议 1；匿名调试可 0）
BILI_REQUIRE_LOGIN=0

# ---------- 公开数据集 / 标注（scripts/get_data.sh） ----------
# 数据集下载目录；来源会自动登记到 data/raw/来源说明.md
DATASET_DIR=data/raw/datasets
# 标注候选与合并后的标注文件目录
LABELING_DIR=data/labeling

# ---------- /api/videos 真实爬取（opt-in，默认关闭） ----------
# 置 1 时「采集评论」阶段调用真实爬虫；默认 0 走占位数据，测试/演示无需联网。
#
# 优先级（同类参数）：任务级 settings（Web「爬虫参数」弹窗确认）> 已保存设置
#   （设置页默认值，outputs/settings.json）> 本组环境变量。
# 即：本组 VIDEO_CRAWL_* 只对「不带 settings 的旧请求 / 未启用分步流水线的任务」生效；
#   带 settings 的 Web 任务以任务快照为准，不读这些变量。
# 注：max_sub_pages 没有环境变量（固定安全默认 1）；0~20 / 0=不限只对 Web 任务级
#   settings 与爬虫 CLI（--max-sub-pages）生效。
VIDEO_REAL_CRAWL=0
# 最多采集一级评论页数：环境变量合法范围 1~50（0=不限仅对任务级 settings 生效，且任务级优先）
VIDEO_CRAWL_MAX_PAGES=1
# 本次最多新增评论数（0=不限）
VIDEO_CRAWL_MAX_ITEMS=200
# 请求最小间隔（秒，不得为负；默认 2.5）。实际采集合规下限 2.0，建议保持 ≥2
VIDEO_CRAWL_DELAY=2.5
# 一级评论每页条数（1~50）
VIDEO_CRAWL_PAGE_SIZE=20
# 一级评论排序：time（按时间）/ hot（按热度）
VIDEO_CRAWL_SORT_MODE=time
# 是否采集楼中楼
VIDEO_CRAWL_INCLUDE_REPLIES=0
# 单次请求超时（秒，须为正数）
VIDEO_CRAWL_TIMEOUT=15
# 是否初始化 buvid3/buvid4（0=关；实测开启会收紧匿名可见评论）
VIDEO_CRAWL_INIT_BUVID=0
# 要求登录态：1 时未登录直接失败（Web 任务级 settings 的同名开关优先）
VIDEO_CRAWL_REQUIRE_LOGIN=0

# ---------- 训练超参数（默认值，可在命令行覆盖） ----------
MAX_LEN=200
MIN_FREQ=3
BATCH_SIZE=64
EPOCHS=20
LEARNING_RATE=0.001
SEED=42
