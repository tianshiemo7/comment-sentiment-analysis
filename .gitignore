# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---------- Node ----------
node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- 环境变量 ----------
.env
.env.local
.env.*.local

# ---------- 数据集（体积大，不入库） ----------
data/raw/*
data/processed/*
data/splits/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/splits/.gitkeep
!data/raw/README.md
!data/processed/README.md
!data/splits/README.md
!data/splits/*.gitkeep
# 保留格式样例
!data/sample/

# ---------- 模型权重（体积大，不入库） ----------
*.pt
*.pth
*.ckpt
*.h5
*.onnx
*.bin
*.safetensors
models/checkpoints/*
models/word2vec/*
models/bert/*
!models/**/.gitkeep
!models/README.md

# ---------- 输出产物 ----------
outputs/logs/*
outputs/predictions/*
outputs/figures/*
outputs/stats/*
outputs/videos/*
!outputs/**/.gitkeep
!outputs/README.md

# ---------- 编辑器 / 系统 ----------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ---------- 报告临时文件 ----------
~$*
*.tmp
