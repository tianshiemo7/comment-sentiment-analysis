# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---------- Node ----------
node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- 环境变量 ----------
.env
.env.local
.env.*.local

# ---------- 数据集（体积大，不入库，只保留目录结构与说明） ----------
# 注意 git 语义：忽略目录内容用 `data/raw/*`（不是 `data/raw/`），否则下面的 ! 反忽略规则全部失效。
data/raw/*
data/processed/*
data/splits/*
# 标注候选 / 合并结果（data/labeling/，体积大且可由 labeling.py 复现）
data/labeling/*
# 数据项目（界面「上传爬取数据」的运行期落盘：data/uploads/<project_id>/ 与 solo_comments.json）
data/uploads/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/splits/.gitkeep
!data/labeling/.gitkeep
!data/uploads/.gitkeep
!data/raw/README.md
!data/raw/来源说明.md
!data/raw/sources.json
# 例外：课程验收用的待训练语料（470 条原始评论，未清洗/未标注，2026-10-17 自采）
!data/raw/BV1tseyzCEoF_comments.csv
# 例外：跨分区大规模采集数据集（2026-10-18，216 视频 / 10,800 条，未清洗，含 train/test 划分）
!data/raw/sentiment_crawl/
#    分片断点、分片合并与排行榜快照体积大且可由脚本复现，不入库
data/raw/sentiment_crawl/shard*/
data/raw/sentiment_crawl/shard*.log
data/raw/sentiment_crawl/*_merged.csv
data/raw/sentiment_crawl/all_comments_raw.csv
data/raw/sentiment_crawl/catalog.json
data/raw/sentiment_crawl/ranking_snapshot.json
!data/processed/README.md
!data/splits/README.md
!data/uploads/README.md
# 保留格式样例
!data/sample/

# ---------- 模型权重（体积大，不入库） ----------
*.pt
*.pth
*.ckpt
*.h5
*.onnx
*.bin
*.safetensors
models/checkpoints/*
models/word2vec/*
models/bert/*
!models/**/.gitkeep
!models/README.md

# ---------- 输出产物 ----------
outputs/logs/*
outputs/predictions/*
outputs/figures/*
outputs/stats/*
outputs/videos/*
outputs/benchmarks/*
# 系统设置（含 Cookie 明文！绝不入库）
outputs/settings.json
outputs/settings.json.tmp
# 端到端验收运行产物（脚本 scripts/e2e_smoke.py 可复现，不入库）
outputs/e2e/*
# 真实数据闭环验证的中间产物（可复现，不入库）
outputs/realdata/*
!outputs/**/.gitkeep
!outputs/README.md

# ---------- 编辑器 / 系统 ----------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ---------- 报告临时文件 ----------
~$*
*.tmp
