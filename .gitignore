# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---------- Node ----------
node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- 环境变量 ----------
.env
.env.local
.env.*.local

# ---------- 数据集（体积大，不入库，只保留目录结构与说明） ----------
# 注意 git 语义：忽略目录内容用 `data/raw/*`（不是 `data/raw/`），否则下面的 ! 反忽略规则全部失效。
data/raw/*
data/processed/*
data/splits/*
# 数据项目（界面「上传爬取数据」的运行期落盘：data/uploads/<project_id>/ 与 solo_comments.json）
data/uploads/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/splits/.gitkeep
!data/uploads/.gitkeep
!data/raw/README.md
!data/processed/README.md
!data/splits/README.md
!data/uploads/README.md
# 保留格式样例
!data/sample/

# ---------- 模型权重（体积大，不入库） ----------
*.pt
*.pth
*.ckpt
*.h5
*.onnx
*.bin
*.safetensors
models/checkpoints/*
models/word2vec/*
models/bert/*
!models/**/.gitkeep
!models/README.md

# ---------- 输出产物 ----------
outputs/logs/*
outputs/predictions/*
outputs/figures/*
outputs/stats/*
outputs/videos/*
!outputs/**/.gitkeep
!outputs/README.md

# ---------- 编辑器 / 系统 ----------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ---------- 报告临时文件 ----------
~$*
*.tmp
